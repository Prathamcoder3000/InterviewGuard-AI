# InterviewGuard-AI Backend Environment Variables

# Set to "true" to use deterministic mock AI analysis without making external API calls
MOCK_AI=true

# Official Google Gemini API Key (required only when MOCK_AI=false)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=

# Resume-based interviewer and answer transcription (independent of MOCK_AI)
GROQ_API_KEY=
GROQ_INTERVIEW_MODEL=openai/gpt-oss-20b

# Server configuration
PORT=8000
HOST=0.0.0.0
